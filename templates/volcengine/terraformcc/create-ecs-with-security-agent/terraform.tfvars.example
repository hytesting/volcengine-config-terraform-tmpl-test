# 复制为 terraform.tfvars 或使用 TF_VAR_* 注入。
# 凭证不要写入本文件，统一通过 ../../../../.credentials.env 加载 VOLCENGINE_* 环境变量。

launch_template_name = "config-ecs-security-agent-baseline"
project_name         = "default"

instance_name        = "config-ecs-security-agent"
instance_type_id     = "ecs.g4i.large"
instance_charge_type = "PostPaid"
image_id             = "image-xxxxxxxxxxxxxxxx"
zone_id              = "cn-guilin-boe-a"
vpc_id               = "vpc-xxxxxxxxxxxxxxxx"
subnet_id            = "subnet-xxxxxxxxxxxxxxxx"
security_group_ids   = ["sg-xxxxxxxxxxxxxxxx"]

system_volume_type = "ESSD_PL0"
system_volume_size = 50

tags = {
  config-rule = "ecs-security-agent-enabled"
  managed-by  = "terraformcc"
}
